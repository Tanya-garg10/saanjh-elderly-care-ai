# FEATHERLESS_API_KEY: Required for Featherless AI API calls (OpenAI-compatible).
# Get your key at: https://featherless.ai
# Set VITE_ prefix so Vite exposes it to the browser-side code.
VITE_FEATHERLESS_API_KEY="YOUR_FEATHERLESS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
